{
  "name": "react-native-platform-components",
  "version": "1.4.0",
  "description": "Native UI components for React Native, the real platform widgets on both iOS and Android: TextField, DatePicker, ContextMenu, SelectionMenu, SegmentedControl, TabBar, Button, ButtonGroup, FloatingToolbar and LiquidGlass. UIKit and SwiftUI on iOS, Material 3 Expressive on Android. Fabric, TypeScript, Expo config plugin.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "browser": "./lib/module/index.web.js",
  "react-native": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "browser": {
        "types": "./lib/typescript/module/src/index.web.d.ts",
        "default": "./lib/module/index.web.js"
      },
      "react-native": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./jest": {
      "source": "./src/jest.tsx",
      "import": {
        "types": "./lib/typescript/module/src/jest.d.ts",
        "default": "./lib/module/jest.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/jest.d.ts",
        "default": "./lib/commonjs/jest.js"
      }
    },
    "./package.json": "./package.json",
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "shared",
    "android",
    "ios",
    "cpp",
    "plugin",
    "*.podspec",
    "react-native.config.js",
    "app.plugin.js",
    "expo-module.config.json",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!plugin/src",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-platform-components-example",
    "example-expo": "yarn workspace react-native-platform-components-example-expo",
    "docs": "yarn workspace react-native-platform-components-docs",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib plugin/build",
    "prepare": "bob build && yarn build:plugin",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "build": "tsc --noEmit",
    "build:plugin": "tsc -p plugin/tsconfig.json && mv plugin/build/index.js plugin/build/index.cjs",
    "release": "release-it",
    "test": "jest",
    "upgrade:check": "yarn dlx npm-check-updates",
    "upgrade:apply": "yarn dlx npm-check-updates -u && rm -rf node_modules && rm -rf package-lock.json && yarn install",
    "generate:gifs": "./scripts/generate-readme-gifs.sh",
    "generate:visuals": "node scripts/visuals/stills.mjs && node scripts/visuals/showreel.mjs"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-config-plugin",
    "ios",
    "android",
    "fabric",
    "new-architecture",
    "native-ui",
    "ui-components",
    "textfield",
    "text-field",
    "textinput",
    "text-input",
    "textinputlayout",
    "uitextfield",
    "datepicker",
    "date-picker",
    "time-picker",
    "datetimepicker",
    "uidatepicker",
    "material-date-picker",
    "menu",
    "context-menu",
    "contextmenu",
    "popup-menu",
    "uicontextmenu",
    "selection-menu",
    "dropdown",
    "picker",
    "segmented-control",
    "segmentedcontrol",
    "segmented-buttons",
    "segmentedbuttons",
    "uisegmentedcontrol",
    "tabs",
    "tab-bar",
    "tabbar",
    "uitabbar",
    "bottom-navigation",
    "navigation-bar",
    "button",
    "buttons",
    "button-group",
    "toggle-buttons",
    "floating-toolbar",
    "toolbar",
    "uibutton",
    "material3-expressive",
    "material-3-expressive",
    "expressive",
    "liquid-glass",
    "liquidglass",
    "glass-effect",
    "uiglasseffect",
    "material-design",
    "material3",
    "material-3",
    "material-you"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JarX-Concepts/react-native-platform-components.git"
  },
  "author": "Andrew Tosh <andrew.tosh@jarxconcepts.com> (https://github.com/ajtosh77)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JarX-Concepts/react-native-platform-components/issues"
  },
  "homepage": "https://github.com/JarX-Concepts/react-native-platform-components#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "^57.0.9",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "^0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.3.0",
    "babel-preset-expo": "^57.0.11",
    "commitlint": "^21.2.2",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^2.0.3",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.1",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "19.2.3",
    "release-it": "^21.0.2",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.0"
  },
  "workspaces": [
    "example",
    "example-expo",
    "docs"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "PlatformComponentsViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.platformcomponents"
    },
    "ios": {
      "modulesProvider": {
        "PlatformComponentsTheme": "PCNativeThemeModule"
      },
      "componentProvider": {
        "PCSelectionMenu": "PCSelectionMenu",
        "PCDatePicker": "PCDatePicker",
        "PCContextMenu": "PCContextMenu",
        "PCSegmentedControl": "PCSegmentedControl",
        "PCTabBar": "PCTabBar",
        "PCTabBarAccessory": "PCTabBarAccessory",
        "PCButton": "PCButton",
        "PCButtonGroup": "PCButtonGroup",
        "PCFloatingToolbar": "PCFloatingToolbar",
        "PCLiquidGlass": "PCLiquidGlass",
        "PCLiquidGlassContainer": "PCLiquidGlassContainer",
        "PCTextField": "PCTextField"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": false
    },
    "npm": {
      "publish": true,
      "skipChecks": true,
      "publishArgs": [
        "--access",
        "public"
      ]
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md",
        "header": "# Changelog"
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/docs/",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/example/e2e/"
    ]
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "fabric-view",
    "tools": [
      "eslint",
      "lefthook",
      "release-it",
      "jest"
    ],
    "version": "0.55.1"
  }
}
