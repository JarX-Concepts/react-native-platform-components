  <!--
    Material 3 Expressive, for Button and ButtonGroup. Theme.Material3Expressive
    only swaps widget styles and motion springs, so applying those as an overlay
    on the host theme keeps the app's colors. The button styles take their
    materialSizeOverlay from the pcButtonSizeOverlay / pcIconButtonSizeOverlay
    theme attributes (attrs.xml), so a PCSize.* overlay around the context
    decides the size and shape.
  -->
  <style name="PCExpressiveOverlay" parent="">
    <item name="pcButtonSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Small</item>
    <item name="pcIconButtonSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.IconButton.Small</item>
    <item name="materialButtonStyle">@style/PCButton.Filled</item>
    <item name="materialButtonTonalStyle">@style/PCButton.Tonal</item>
    <item name="materialButtonOutlinedStyle">@style/PCButton.Outlined</item>
    <item name="materialButtonElevatedStyle">@style/PCButton.Elevated</item>
    <item name="borderlessButtonStyle">@style/PCButton.Text</item>
    <item name="materialIconButtonStyle">@style/PCButton.IconStandard</item>
    <item name="materialIconButtonFilledStyle">@style/PCButton.IconFilled</item>
    <item name="materialIconButtonFilledTonalStyle">@style/PCButton.IconTonal</item>
    <item name="materialIconButtonOutlinedStyle">@style/PCButton.IconOutlined</item>
    <item name="materialButtonGroupStyle">@style/Widget.Material3Expressive.MaterialButtonGroup</item>
    <item name="materialButtonToggleGroupStyle">@style/Widget.Material3Expressive.MaterialButtonToggleGroup</item>
    <item name="motionSpringFastSpatial">@style/Motion.Material3.Spring.Expressive.Fast.Spatial</item>
    <item name="motionSpringFastEffects">@style/Motion.Material3.Spring.Expressive.Fast.Effects</item>
    <item name="motionSpringDefaultSpatial">@style/Motion.Material3.Spring.Expressive.Default.Spatial</item>
    <item name="motionSpringDefaultEffects">@style/Motion.Material3.Spring.Expressive.Default.Effects</item>
    <item name="motionSpringSlowSpatial">@style/Motion.Material3.Spring.Expressive.Slow.Spatial</item>
    <item name="motionSpringSlowEffects">@style/Motion.Material3.Spring.Expressive.Slow.Effects</item>
  </style>

  <!-- Connected group of plain actions (the standard group is the default). -->
  <style name="PCExpressiveOverlay.ConnectedGroup">
    <item name="materialButtonGroupStyle">@style/Widget.Material3Expressive.MaterialButtonGroup.Connected</item>
