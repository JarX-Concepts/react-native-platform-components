  <!--
    Native theme (useNativeTheme / setNativeTheme, see PCNativeTheme). DynamicColors
    overrides Material's "personalized" color resources with the scheme generated from
    the brand color and applies ThemeOverlay.Material3.PersonalizedColors to the
    activity. This overlay points the accent attributes that platform and AppCompat
    widgets (DatePicker, TimePicker, Spinner) read at the primary color (the
    personalized control color is a light tone that white labels don't contrast
    with), and is re-applied over the Material 3 fallback contexts, which would
    otherwise reset the colors.
  -->
  <style name="PCNativeThemeOverlay" parent="ThemeOverlay.Material3.PersonalizedColors">
    <item name="colorAccent">?attr/colorPrimary</item>
    <item name="android:colorAccent">?attr/colorPrimary</item>
    <item name="android:colorControlActivated">?attr/colorPrimary</item>
  </style>

